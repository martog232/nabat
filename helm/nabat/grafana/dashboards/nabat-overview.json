{
  "uid": "nabat-overview",
  "title": "Nabat — service overview",
  "description": "What to look at first when something is wrong. Every query here is one a rule in prometheus/rules.yml also evaluates, so the alert and the panel cannot disagree about what they measure.",
  "tags": ["nabat"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "row",
      "title": "Serving",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Request rate by status",
      "description": "Actuator paths excluded: Prometheus scrapes them every 15s, which would dominate the graph and tell you nothing about users.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"nabat-app\",uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "5xx share of requests",
      "description": "The same ratio HighServerErrorRate alerts on, at the same 5 % threshold.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"nabat-app\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"nabat-app\"}[5m])), 0.001)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Targets up",
      "description": "nabat-voting reads 0 in the compose stack by design — it runs from its own compose file and this target cannot resolve.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value_and_name" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request latency p95 by endpoint",
      "description": "Needs the bucket series: percentiles-histogram is enabled for http.server.requests in application.properties. Quantiles are computed at query time so they aggregate correctly across replicas.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"nabat-app\",uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Use cases",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "type": "timeseries",
      "title": "Use-case call rate by outcome",
      "description": "From UseCaseMetricsAspect, which times every @UseCase method. This is the only view that covers work with no HTTP request behind it: the scheduled photo sweep, the alert fan-out, event listeners.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (usecase, outcome) (rate(nabat_usecase_duration_seconds_count[5m]))",
          "legendFormat": "{{usecase}} · {{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Use-case duration p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, usecase) (rate(nabat_usecase_duration_seconds_bucket[5m])))",
          "legendFormat": "{{usecase}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Resources",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }
    },
    {
      "type": "timeseries",
      "title": "Database connection pool",
      "description": "Pending above zero is the one to care about: it means threads are queued for a connection, so everything behind the queue pays for it. Raising the pool moves the queue into Postgres.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(hikaricp_connections_active{job=\"nabat-app\"})",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(hikaricp_connections_idle{job=\"nabat-app\"})",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(hikaricp_connections_pending{job=\"nabat-app\"})",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Heap used",
      "description": "Read the floor, not the peaks: a sawtooth is healthy GC, a rising floor is a leak.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.9 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (instance) (jvm_memory_used_bytes{job=\"nabat-app\",area=\"heap\"}) / sum by (instance) (jvm_memory_max_bytes{job=\"nabat-app\",area=\"heap\"})",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Log events by level",
      "description": "From logback_events_total, not from Loki: this is a counter the application exports, so it works even when log shipping is the thing that is broken.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (level) (rate(logback_events_total{job=\"nabat-app\",level=~\"warn|error\"}[5m]))",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Logs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 }
    },
    {
      "type": "logs",
      "title": "Warnings and errors",
      "description": "Straight from Loki, using the level label Promtail promotes from the ECS log.level field. Copy a traceId out of a line and paste it into the Zipkin datasource to see the request it belongs to.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 36 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{container=\"nabat-app\", level=~\"WARN|ERROR\"}"
        }
      ]
    }
  ]
}
