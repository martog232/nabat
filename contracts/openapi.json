    "/api/v1/alerts/nearby" : {
      "get" : {
        "tags" : [ "alert-controller" ],
        "summary" : "Active alerts within a radius, optionally filtered and newer than `since`",
        "operationId" : "getNearbyAlerts",
        "parameters" : [ {
          "name" : "latitude",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "number",
            "format" : "double",
            "maximum" : 90.0,
            "minimum" : -90.0
          }
        }, {
          "name" : "longitude",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "number",
            "format" : "double",
            "maximum" : 180.0,
            "minimum" : -180.0
          }
        }, {
          "name" : "radiusKm",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "number",
            "format" : "double",
            "default" : 5.0,
            "maximum" : 100.0,
            "minimum" : 0.0
          }
        }, {
          "name" : "since",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        }, {
          "name" : "type",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "POTHOLE", "MANHOLE", "WASTE", "POLLUTION", "STREET_LIGHT", "ILLEGAL_PARKING", "OTHER" ]
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 100,
            "maximum" : 500,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NearbyAlertsResponse"
