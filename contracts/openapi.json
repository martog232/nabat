  "components" : {
    "schemas" : {
      "WebSocketTicketResponse" : {
        "type" : "object",
        "properties" : {
          "ticket" : {
            "type" : "string"
          },
          "expiresAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "NotificationResponse" : {
        "type" : "object",
        "description" : "A user notification (vote event or milestone)",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Notification identifier"
          },
          "recipientId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "ID of the user who receives this notification"
          },
          "type" : {
            "type" : "string",
            "description" : "What triggered the notification",
            "enum" : [ "ALERT_UPVOTED", "ALERT_DOWNVOTED", "ALERT_CONFIRMED", "ALERT_MILESTONE", "ALERT_RESOLVED" ],
            "example" : "VOTE"
          },
          "title" : {
            "type" : "string",
            "description" : "Short notification title",
            "example" : "New vote on your alert"
          },
          "message" : {
            "type" : "string",
            "description" : "Notification body text"
          },
          "relatedAlertId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Alert that triggered the notification; may be null"
          },
          "triggeredByUserId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "User who caused the notification; may be null"
          },
          "read" : {
            "type" : "boolean",
            "description" : "Whether the notification has been read by the recipient"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Timestamp when the notification was created"
          }
        }
      },
      "MessageResponse" : {
        "type" : "object",
        "properties" : {
          "message" : {
            "type" : "string"
          }
        }
      },
      "ResetPasswordRequest" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string",
            "minLength" : 1
          },
          "newPassword" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "newPassword", "token" ]
      },
      "RegisterRequest" : {
        "type" : "object",
        "description" : "Request body for creating a new user account",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "description" : "E-mail address (used as login)",
            "example" : "alice@example.com",
            "minLength" : 1
          },
          "password" : {
            "type" : "string",
            "description" : "Password — at least 10 characters, including a letter and a digit, and at most 72 UTF-8 bytes",
            "example" : "s3cr3tP@ssphrase",
            "minLength" : 10
          },
          "displayName" : {
            "type" : "string",
            "description" : "Public display name shown to other users",
            "example" : "Alice",
            "maxLength" : 50,
            "minLength" : 2
          }
        },
        "required" : [ "displayName", "email", "password" ]
      },
      "AuthResponse" : {
        "type" : "object",
        "description" : "Authentication tokens returned after a successful login or registration",
        "properties" : {
          "accessToken" : {
            "type" : "string",
            "description" : "Short-lived JWT access token — include in Authorization: Bearer header"
          },
          "refreshToken" : {
            "type" : "string",
            "description" : "Single-use refresh token used to obtain a new pair"
          },
          "expiresIn" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Access-token validity in milliseconds",
            "example" : 86400000
          },
          "user" : {
            "$ref" : "#/components/schemas/UserResponse",
            "description" : "Basic profile of the authenticated user"
          }
        }
      },
      "UserResponse" : {
        "type" : "object",
        "description" : "Public profile of a user",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Stable user identifier"
          },
          "email" : {
            "type" : "string",
            "description" : "E-mail address",
