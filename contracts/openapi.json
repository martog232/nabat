  "components" : {
    "schemas" : {
      "WebSocketTicketResponse" : {
        "type" : "object",
        "properties" : {
          "ticket" : {
            "type" : "string"
          },
          "expiresAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "SubscriptionRequest" : {
        "required" : [ "alertType", "latitude", "longitude", "radiusKm" ],
        "type" : "object",
        "properties" : {
          "alertType" : {
            "type" : "string",
            "description" : "Alert type to subscribe to",
            "example" : "GAS_LEAK",
            "enum" : [ "CRIME", "FIRE", "ACCIDENT", "MEDICAL_EMERGENCY", "NATURAL_DISASTER", "SUSPICIOUS_ACTIVITY", "TRAFFIC", "HAZARD", "MISSING_PERSON", "OTHER" ]
          },
          "latitude" : {
            "type" : "number",
            "description" : "Center latitude of the watch area",
            "format" : "double",
            "example" : 40.7128
          },
          "longitude" : {
            "type" : "number",
            "description" : "Center longitude of the watch area",
            "format" : "double",
            "example" : -74.006
          },
          "radiusKm" : {
            "type" : "number",
            "description" : "Radius in kilometres around the center point",
            "format" : "double",
            "example" : 5.0
          }
        },
        "description" : "Request body for creating an alert subscription"
      },
      "SubscriptionResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "description" : "Subscription identifier",
            "format" : "uuid"
          },
          "userId" : {
            "type" : "string",
            "description" : "Owner of the subscription",
            "format" : "uuid"
          },
          "alertType" : {
            "type" : "string",
            "description" : "Subscribed alert type",
