# Copy this file to .env for local Docker Compose runs.
# Never commit a real secret.

# REQUIRED. Generate your own — this is intentionally left blank so that no shared,
# publicly-known signing key can reach a deployment:
#
#     openssl rand -base64 48
#
# Must be >= 32 chars with >= 16 distinct characters, and must not look like a
# placeholder (see JwtTokenProvider.REJECTED_MARKERS) or the app refuses to start.
# nabat-app and nabat-voting must be given the SAME value.
JWT_SECRET=

# PostgreSQL defaults used by docker-compose.yml and local app runs.
# Docker exposes Postgres on host port 5433 by default to avoid conflicts with
# a locally installed PostgreSQL on 5432. Inside Docker, services still use postgres:5432.
POSTGRES_HOST_PORT=5433
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/nabat_db
SPRING_DATASOURCE_USERNAME=nabat_user
SPRING_DATASOURCE_PASSWORD=nabat_password

SERVER_PORT=8080

# Comma-separated allowed CORS origins. Empty means no cross-origin browser requests.
# Example: NABAT_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
NABAT_CORS_ALLOWED_ORIGINS=

# Photo storage. `filesystem` (local disk) or `s3` (any S3-compatible endpoint).
# docker-compose sets s3 and runs MinIO, because local disk breaks as soon as there is
# more than one replica: a photo written by one pod is absent from the other.
# These two override the MinIO root credentials the compose stack starts with; leave them
# unset to use the development defaults in docker-compose.yml.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# External voting service.
#
# docker-compose.yml sets this to http://nabat-voting-app:8081 for the container and does
# not read the value below — inside a container, localhost is the container. This one is
# for running the app on the host with `mvnw spring-boot:run` against a voting service
# published on 8081 (either compose profile, or nabat-voting's own stack).
#
# The voting service, its Kafka and its database are behind the `voting` compose profile:
#     docker compose --profile voting up
# Without it, every vote answers 503 — there is no local vote path since V7.
NABAT_VOTING_SERVICE_BASE_URL=http://localhost:8081

# Which nabat-voting image the compose profile runs. Defaults to the published one; point
# it at a locally built tag when working on that service.
NABAT_VOTING_IMAGE=

# Host port for the voting service's own Postgres. Separate database, not a second schema:
# owning its data is most of the reason that service exists.
VOTING_POSTGRES_HOST_PORT=5434
NABAT_VOTING_SERVICE_AUTH_TOKEN=
NABAT_VOTING_SERVICE_CONNECT_TIMEOUT=PT2S
NABAT_VOTING_SERVICE_READ_TIMEOUT=PT3S
